# Vim swap files
*.swp
*.swo
*~

# Python bytecode. There is still no build step and no packaging.
# (The "no virtualenv" this comment used to claim came from ARCHITECTURE.md §2,
# which describes candidate 1. Candidate 2 was adopted and IMPLEMENTATION_PLAN.md
# §1.2 fixes the runtime as a project virtual environment — see the next stanza.)
__pycache__/
*.py[cod]

# The project virtual environment. IMPLEMENTATION_PLAN.md §1.2 fixes the suite
# command as `.venv/bin/python -m pytest -q` from the repository root, so every
# developer has one of these and none of them belongs in the repository. It is
# rebuilt from requirements.txt — see README.md.
.venv/
/venv/
.pytest_cache/

# macOS
.DS_Store

# Scratch left behind by a spike or a manual run.
/spikes/*.out
/spikes/*.log

# Agent worktrees created by Claude Code
.claude/worktrees/

# macOS
.DS_Store

# Orchestration monitor: run-local state, not project source
orchestration/archive/
orchestration/requests/

# The conductor's own progress log, written live into the primary tree while
# the run is going. Developers write theirs inside a worktree and commit them
# on the branch; the conductor has no worktree, so its log sits here untracked
# and collides with any pull that brings the same path down from a branch.
# Untracked-and-in-the-way is the one state git will not resolve for you.
docs/progress/conductor.md

# The code reviewer's GitHub App private key, if anyone ever puts one here.
# It belongs outside the repository — this repository is public, so a committed
# key is a published key — but the ignore rule costs nothing and the mistake is
# not undoable by deleting the file in a later commit.
*.pem
