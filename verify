# ==========================================================================
# A stage, and its result
# ==========================================================================


class StageResult(object):
    """What one stage did. ``detail`` is the sentence a failure is read by."""

    def __init__(self, name, proves, ok, detail="", output="", seconds=0.0):
        self.name = name
        self.proves = proves
        self.ok = bool(ok)
        self.detail = detail
        self.output = output
        self.seconds = seconds

    def __str__(self):
        return "%s %s" % ("ok  " if self.ok else "FAIL", self.name)


class Stage(object):
    """A named step of the verification.

    ``short`` is what ``--only`` takes, ``name`` is what a failure is announced
    by, and ``proves`` is the one line that tells somebody who has never read
    this file what it was for.
    """

    def __init__(self, short, name, proves, run, opens_a_window=False):
        self.short = short
        self.name = name
        self.proves = proves
        self.run = run
        self.opens_a_window = opens_a_window


def run_command(command, cwd, timeout=STAGE_TIMEOUT_SECONDS):
    """Run a command and hand back ``(status, combined output)``.

    stderr is folded into stdout because the point of capturing it at all is to
    print it under a failure banner, and two streams printed one after the
    other put a traceback's cause after its effect.
    """
    try:
        completed = subprocess.run(
            list(command),
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as expired:
        partial = expired.output or b""
        return None, partial.decode("utf-8", "replace")
    except OSError as error:
        return None, "could not run %s: %s" % (" ".join(command), error)
    return completed.returncode, completed.stdout.decode("utf-8", "replace")


# ==========================================================================
# Stage 1 -- the whole test suite
# ==========================================================================


def stage_the_test_suite(root=REPO_ROOT, run=None):
    """Run the pinned command and read its own summary line back."""
    runner = run_command if run is None else run
    began = time.time()
    status, output = runner(TEST_COMMAND, root)
    seconds = time.time() - began
    if status is None:
        return StageResult(
            SUITE_NAME,
            SUITE_PROVES,
            False,
            "the test command did not complete: %s"
            % (first_line(output) or "no output"),
            output,
            seconds,
        )
    if status != 0:
        return StageResult(
            SUITE_NAME,
            SUITE_PROVES,
            False,
            "%s exited %d -- %s"
            % (" ".join(TEST_COMMAND), status, summary_of_a_unittest_run(output)),
            output,
            seconds,
        )
    return StageResult(
        SUITE_NAME,
        SUITE_PROVES,
        True,
        summary_of_a_unittest_run(output),
        output,
        seconds,
    )


def summary_of_a_unittest_run(output):
    """``unittest``'s own two summary lines, joined, or a note that there are
    none.

    Quoted verbatim rather than re-counted, because the plan requires the
    counts reported to be the ones that command printed and no others.
    """
    interesting = []
    for line in output.splitlines():
        stripped = line.strip()
        if stripped.startswith("Ran ") or stripped.startswith("OK"):
            interesting.append(stripped)
        elif stripped.startswith("FAILED"):
            interesting.append(stripped)
    if not interesting:
        return "the run printed no summary line"
    return "; ".join(interesting)


def first_line(text):
    for line in text.splitlines():
        if line.strip():
            return line.strip()
    return ""


SUITE_NAME = "the test suite"
SUITE_PROVES = (
